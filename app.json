{
  "expo": {
    "name": "Dailift",
    "slug": "dailift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailift",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.dohun1214.dailift",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dohun1214.dailift"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0F1012"
          }
        }
      ],
      "react-native-edge-to-edge",
      "expo-localization",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#15171A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dailift uses your photos so you can attach workout photos. Photos stay on your device.",
          "cameraPermission": "Dailift uses the camera so you can take workout photos. Photos stay on your device.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.85791918223-tccvuepnbqg684npigc9m67hu8nteknq"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
