{
  "expo": {
    "name": "Dailift",
    "slug": "dailift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailift",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.dohun1214.dailift",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1012",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dohun1214.dailift"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0F1012",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "react-native-edge-to-edge",
      "expo-localization",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#15171A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dailift uses your photo library so you can attach photos to your workouts.",
          "cameraPermission": "Dailift uses the camera so you can take photos and attach them to your workouts.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.85791918223-tccvuepnbqg684npigc9m67hu8nteknq"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a69775b9-53c1-4c04-806a-01fdd415c479"
      }
    },
    "owner": "dohun1214"
  }
}
